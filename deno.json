{
  "tasks": {
    // A serial port needs --allow-all. Deno treats /dev/* as special files and
    // refuses Deno.open() on them under --allow-read --allow-write alone:
    //   NotCapable: Requires all access to "/dev/ttyUSB0", run again with the
    //   --allow-all flag
    // `start:tcp` is the real permission set when HOUR_METER_PORT is tcp://
    // (the simulator or a serial-to-TCP bridge); --allow-read is for the
    // createRequire of vendor/.
    "start": "deno run -A main.ts",
    "start:tcp": "deno run --allow-net --allow-env --allow-read main.ts",
    "dev": "deno run --watch --env-file=.env.local -A main.ts",
    "check": "deno check main.ts scripts/ tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    // Hermetic: no Redis, no device. --allow-net=127.0.0.1 is for the
    // boot-resilience suite, which points the reader at a closed local port.
    "test": "deno test --allow-read --allow-env --allow-net=127.0.0.1 tests/",
    // vendor/hour-meter is a byte-identical mirror of the device's codec and
    // reader (see vendor/hour-meter/README.md). Never edit it by hand.
    "vendor:sync": "deno run --allow-read --allow-write=vendor,tests/fixtures --allow-run=git --allow-env=HM_UPSTREAM_PATH scripts/vendor-sync.ts",
    "vendor:verify": "deno run --allow-read --allow-run=git --allow-env=HM_UPSTREAM_PATH scripts/verify-vendor.ts",
    "release": "deno run --allow-read --allow-write --allow-run --allow-env scripts/release.ts",
    "changeset": "deno run -A npm:@changesets/cli@2.31.0",
    "version-packages": "deno run -A npm:@changesets/cli@2.31.0 version",
    "verify:version": "deno run --allow-read scripts/verify-version.ts"
  },
  // Keep npm dependencies in Deno's own cache, not a local node_modules. This
  // repo carries a `package.json` as the @changesets/cli manifest (see
  // FMS-Backend/docs/ecosystem/versioning.md), and Deno treats a directory
  // containing package.json as a Node project and switches to node_modules
  // resolution, which breaks every `npm:` import until `deno install` is run.
  "nodeModulesDir": "none",
  // The vendored codec (vendor/hour-meter/sensorframe/js) is CommonJS loaded
  // through createRequire, and its package.json has no "type". Inside this
  // project Deno assumes ESM for such a .js file and fails with
  // `ReferenceError: require is not defined`; detect-cjs makes it apply Node's
  // rule instead. Adding "type": "commonjs" to the mirror is not an option:
  // vendor:verify requires it byte-identical to upstream.
  "unstable": ["detect-cjs"],
  // The mirror keeps upstream's formatting (single quotes, 120 columns);
  // reformatting it would break the hashes vendor:verify checks.
  "fmt": {
    "exclude": ["vendor/", "tests/fixtures/"]
  },
  "lint": {
    "exclude": ["vendor/", "tests/fixtures/"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.9",
    "hono": "jsr:@hono/hono@^4.12.18",
    "redis": "npm:redis@^5.12.1",
    "app": "./src/app.ts",
    "handlers": "./src/handlers/index.ts",
    "helpers": "./src/helpers/index.ts",
    "modules": "./src/modules/index.ts",
    "hour-meter": "./src/modules/hour-meter.ts",
    "sensors": "./src/sensors/index.ts",
    "consts": "./src/constants/index.ts",
    "types": "./src/@types/index.ts",
    "errors": "./src/errors/index.ts",
    "classes/bases": "./src/classes/bases/index.ts"
  }
}
