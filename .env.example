# microservice.hm — copy to .env.local for `deno task dev`.

# The vehicle's local Redis, the one geofencer subscribes on. A password goes
# in the URL (redis://:secret@host:port); it is never logged.
REDIS_URL=redis://localhost:6379

# HTTP: GET / and GET /health. On a cab box with host networking, pick a free
# port (geofencer 8800, microservice.gps 8801).
PORT=9000

# Where the hour meter is:
#   /dev/serial/by-id/usb-…-if00-port0   serial, stable name (recommended)
#   /dev/ttyUSB0, /dev/ttyACM0           serial, kernel name (can swap at boot)
#   /dev/rfcomm0                         Bluetooth SPP (set HOUR_METER_BT_PIN)
#   tcp://127.0.0.1:5555                 simulator, or a serial-to-TCP bridge
# Keep the tcp:// prefix: a bare host:port is taken for a file path.
# Serial needs `deno task start` (-A); tcp:// runs with `deno task start:tcp`.
HOUR_METER_PORT=/dev/ttyUSB0

# Serial only. USB is always 115200; the UART pins follow the device's
# uartBaud setting.
HOUR_METER_BAUD=115200

# Bluetooth only: the device's btPin. A locked session sends nothing.
# HOUR_METER_BT_PIN=1234

# No frame for this long: probe the device with a status request; /health
# turns 503. Do not go much lower: when the probe gets no answer the port is
# reopened, and reopening a USB port reboots the device.
HOUR_METER_STALE_MS=15000

# Pause before reopening a closed or failed link.
HOUR_METER_RECONNECT_DELAY_MS=5000

# Set the device clock (setTime) whenever it reports it does not know the
# time — e.g. an RTC without a backup battery after the ignition cut power.
# Never sent while this host's own clock is unset.
HOUR_METER_TIME_SYNC=true

# One log line per TELEMETRY frame.
LOGGING=false

# Travel direction (forward / reversing / stopped) from the IMU stream and
# microservice.gps. false on excavators: a board in the cab turns with the
# house, not with the tracks. Works best with the device's imuStreamHz at 100.
HOUR_METER_DIRECTION=true

# Which board axis points to the vehicle's front: +x, -x, +y or -y.
# GET /health → direction.mountCheck warns when it looks wrong.
HOUR_METER_FORWARD_AXIS=+x

# Above this GPS speed the unit is taken to be going forward. 0 for graders
# and compactors, which reverse fast.
HOUR_METER_REVERSE_MAX_KMH=20

# Record the direction inputs (NDJSON, hourly files, 24 kept) for calibration.
# HOUR_METER_DIRECTION_RECORD=/var/lib/microservice.hm/direction

# Which IMU this service uses and broadcasts: hm (the hour meter's own, when
# it has one) or wit (a WitMotion WT61 through wt61-driver: 100 Hz, filtered
# on the module). It feeds the travel direction, hour-meter:imu, and
# rollDeg/pitchDeg on hour-meter:update (imuSource says whose). headingDeg and
# the vibration stay the hour meter's either way. geofencer's dev console can
# switch it while running (setImuSource), kept in the Redis key
# hour-meter:imu-source, which wins over this until cleared.
HOUR_METER_IMU_SOURCE=hm

# The selected IMU on hour-meter:imu, each message a window's mean, for
# geofencer's dev console. Messages per second, at most 50; 0 publishes nothing.
HOUR_METER_IMU_HZ=10

# Where wt61-driver listens; read only with HOUR_METER_IMU_SOURCE=wit.
# Contract: FMS-Backend/docs/ecosystem/integrations/wt61-driver-to-hm.md
# WT61_URL=tcp://127.0.0.1:6699

# Which WT61 axis points to the vehicle's front: +x, -x, +y or -y (the module
# flat, Z up). HOUR_METER_FORWARD_AXIS still describes the hour meter's board —
# its compass gives forwardHeadingDeg.
WT61_FORWARD_AXIS=+x

# No line from the driver for this long: reconnect. Harmless — the driver keeps
# the module's serial port open and sends a status line every second.
WT61_STALE_MS=2000
WT61_RECONNECT_DELAY_MS=2000
